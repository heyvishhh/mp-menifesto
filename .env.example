# MP Manifesto Analysis Dashboard - Environment Variables
# Copy this file to .env.local for local overrides

# Application Mode: 'development' | 'production'
NEXT_PUBLIC_APP_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_DEV_MOCK_FALLBACK=true
NEXT_PUBLIC_DEFAULT_LOCALE=hi

# Supabase Configuration (For Stage 3 Cloud Integration)
# Replace with actual values from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Server-side API routes only - never expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Direct PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Obtain from Supabase Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage Buckets
NEXT_PUBLIC_STORAGE_BUCKET_WORKBOOKS=manifesto-workbooks
NEXT_PUBLIC_STORAGE_BUCKET_EXPORTS=manifesto-exports

# Excel Export / Import Max File Size in Bytes (default: 15MB)
MAX_EXCEL_UPLOAD_SIZE_BYTES=15728640

